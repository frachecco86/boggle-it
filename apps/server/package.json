{
  "name": "@boggle/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "gen:schede": "tsx scripts/gen-schede.ts",
    "gen:schede:ale": "tsx scripts/gen-schede-ale.ts",
    "verify:schede": "tsx scripts/verify-schede.ts",
    "measure:schede": "tsx scripts/measure-schede.ts"
  },
  "dependencies": {
    "@boggle/dictionary": "workspace:*",
    "@boggle/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
