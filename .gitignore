node_modules/
dist/
.turbo/

# Log e OS
*.log
.DS_Store

# Ambiente
.env
.env.local

# Dati dizionario: fonti grezze e output non compresso (words.br E' versionato:
# e' il dizionario compresso, ~830 KB, e rende i deploy riproducibili).
# 60000_parole_italiane.txt È versionato (MIT, ~556 KB): entra nel dizionario
# completo (`build-words.mjs`) e rende il build Docker riproducibile offline.
# Le FASCE di difficoltà delle schede NON vengono da questo file (è alfabetico):
# vengono da `frequency-it.txt`, vedi sotto.
packages/dictionary/data/morph-it_048.txt
# Lista estesa (280k): serve SOLO a rigenerare words.txt (`build:full`). Le sue
# parole sono già dentro words.br, quindi il deploy non ne ha bisogno. 3 MB nel
# repo per una fonte che si scarica con `pnpm --filter @boggle/dictionary fetch`
# non vale il peso. `blocked-words.txt` È invece versionato: e' un file di policy
# (5 KB) e deve restare leggibile e modificabile nel repository.
packages/dictionary/data/280000_parole_italiane.txt
# Lista di frequenza grezza (FrequencyWords, 9,7 MB): si scarica con
# `pnpm --filter @boggle/dictionary fetch`. L'output filtrato delle fasce
# (`frequency-it.txt`, 60k parole giocabili) È versionato: serve al generatore
# delle schede e non deve dipendere dalla rete.
packages/dictionary/data/frequency-it.raw.txt
packages/dictionary/data/current_version/
packages/dictionary/data/words.txt
packages/dictionary/data/.sources.json

# Vite
apps/web/.vite/
tsconfig.tsbuildinfo

# Dizionario copiato per la CDN (rigenerato dal build)
apps/web/public/dictionary/
apps/web/tsconfig.tsbuildinfo

# Schede generate dall'admin: vivono in DATA_DIR/schede-extra, non versionate

# Android (Capacitor): web sincronizzato e output di build
apps/web/dist/
apps/web/android/app/src/main/assets/public/
apps/web/android/app/src/main/assets/capacitor.config.json
apps/web/android/.gradle/
apps/web/android/build/
apps/web/android/app/build/
apps/web/android/local.properties
apps/web/public/bundled-schede/

# Dati persistenti del server in sviluppo: DB profili + schede admin
/data/

# Output della build APK: gli APK pubblicati sono versionati in dist-android/
# (vedi dist-android/README.md). La cartella di build grezza di Gradle resta fuori.
apps/web/android/app/build/
apps/web/android/local.properties

# Nella cartella degli APK versionati si committano solo APK, AAB e la guida.
dist-android/*
!dist-android/README.md
!dist-android/*.apk
!dist-android/*.aab

# Indice lessicale (parola -> categoria grammaticale + voce Wikizionario):
# VERSIONATO. Contiene i tag grammaticali di ~352k parole e i link a Wikizionario.
# Senza di esso i tag non sono ricostruibili nei build di deploy (Morph-it!, la
# fonte, è gitignored): era il bug per cui in produzione la pagina Parole mostrava
# tutte le voci come `n.c.`. ~740 KB compressi, vale il costo.
!packages/dictionary/data/word-index.br
packages/dictionary/data/word-index.txt
# Dump grezzo di Wikizionario (40 MB): solo per rigenerare gli headword.
packages/dictionary/data/itwiktionary.jsonl.gz
