# ---- Client (build-time, prefisso VITE_) ----
# URL del server Socket.IO.
# Lascia vuoto se il frontend e' servito dallo stesso dominio del server.
# Con Netlify, impostalo all'URL pubblico del server Railway.
VITE_SERVER_URL=

# Base del dizionario. Vuoto = <VITE_SERVER_URL>/dictionary oppure same-origin.
# Con Netlify puoi servire il dizionario dalla CDN: /dictionary
VITE_DICTIONARY_URL=

# ---- Server (runtime) ----
# Porta HTTP/Socket.IO (Railway la inietta automaticamente).
PORT=3001

# Token per il pannello admin (/admin) e le API /admin/*.
# Se non impostato, l'admin resta DISABILITATO (503): nessun rischio per dimenticanza.
# Genera un valore lungo e casuale, es. `openssl rand -hex 24`.
ADMIN_TOKEN=

# Percorso alternativo del catalogo schede base (default packages/shared/schede)
# SCHEDE_DIR=
# Percorso delle schede aggiunte dall'admin (default <DATA_DIR>/schede-extra)
# SCHEDE_EXTRA_DIR=

# Lunghezza massima delle parole nel pool di generazione schede (default 14).
# SCHEDA_MAX_WORD_LENGTH=14

# Origini client consentite, separate da virgola. Usa * per consentirle tutte.
# In produzione: https://tuo-sito.netlify.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Durata round / countdown / pausa (ms). Utile per test rapidi.
ROUND_DURATION_MS=180000
COUNTDOWN_MS=3000
ROUND_END_PAUSE_MS=10000

# ---- Profili (SQLite) ----
# Dati persistenti: DB profili (SQLite) + schede generate dall'admin.
# Contiene boggle.db (nome storico, vedi il codice: e' il DB dei profili) e schede-extra/.
#
# Su Railway monta UN volume su /app/data: copre profili e schede insieme.
# Il Dockerfile NON dichiara VOLUME (Railway non lo supporta): il volume si
# configura dalla piattaforma. Serve anche RAILWAY_RUN_UID=0 per i permessi
# (il volume e' montato come root, il container gira come `node`).
DATA_DIR=./data
# Backup: con SQLite WAL il file boggle.db (nome storico) da solo puo' NON contenere
# le scritture recenti. Il server consolida su SIGTERM; per forzarlo: POST /admin/db/checkpoint.

# ---- App Android ----
# URL del server per il multiplayer. Impostalo PRIMA di `pnpm cap:sync`.

# Lunghezza massima delle parole caricate nel trie del solver.
# NON PIÙ USATO a runtime: le parole valide arrivano dalle schede. Resta per compatibilità.
# TRIE_MAX_WORD_LENGTH=10

# Percorsi opzionali (default calcolati dal layout del repo).
# DICT_DIR=/app/packages/dictionary/data
# WEB_DIST=/app/apps/web/dist


# ---- Admin (pannello /admin) ----
# Credenziali per generare schede dall'app. Stanno QUI e non nel codice:
# il repository e' pubblico, una password nel sorgente sarebbe leggibile da tutti.
#
# Se non impostate, le rotte admin rispondono 503 (admin disabilitato).
# Il login restituisce un token di sessione valido 12 ore: la password viaggia
# una volta sola e non a ogni richiesta.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-questa-password

# Retro-compatibilita': vecchio token statico. Se impostato, e' ancora accettato
# come Bearer. Preferisci ADMIN_USER/ADMIN_PASSWORD.
# ADMIN_TOKEN=
