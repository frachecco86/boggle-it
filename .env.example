# ---- Client (build-time, prefisso VITE_) ----
# URL del server Socket.IO.
# Lascia vuoto se il frontend e' servito dallo stesso dominio del server.
# Con Netlify, impostalo all'URL pubblico del server Railway.
VITE_SERVER_URL=

# Base del dizionario. Vuoto = <VITE_SERVER_URL>/dictionary oppure same-origin.
# Con Netlify puoi servire il dizionario dalla CDN: /dictionary
VITE_DICTIONARY_URL=

# ---- Server (runtime) ----
# Porta HTTP/Socket.IO (Railway la inietta automaticamente).
PORT=3001

# Token per il pannello admin (/admin) e le API /admin/*.
# Se non impostato, l'admin resta DISABILITATO (503): nessun rischio per dimenticanza.
# Genera un valore lungo e casuale, es. `openssl rand -hex 24`.
ADMIN_TOKEN=

# Percorso alternativo del catalogo schede base (default packages/shared/schede)
# SCHEDE_DIR=
# Percorso delle schede aggiunte dall'admin (default packages/shared/schede-extra)
# SCHEDE_EXTRA_DIR=

# Lunghezza massima delle parole nel pool di generazione schede (default 14).
# SCHEDA_MAX_WORD_LENGTH=14

# Origini client consentite, separate da virgola. Usa * per consentirle tutte.
# In produzione: https://tuo-sito.netlify.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Durata round / countdown / pausa (ms). Utile per test rapidi.
ROUND_DURATION_MS=180000
COUNTDOWN_MS=3000
ROUND_END_PAUSE_MS=10000

# Lunghezza massima delle parole caricate nel trie del solver.
# NON PIÙ USATO a runtime: le parole valide arrivano dalle schede. Resta per compatibilità.
# TRIE_MAX_WORD_LENGTH=10

# Percorsi opzionali (default calcolati dal layout del repo).
# DICT_DIR=/app/packages/dictionary/data
# WEB_DIST=/app/apps/web/dist
